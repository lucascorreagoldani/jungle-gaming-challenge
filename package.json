{
  "name": "junglegaming",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun run --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target node",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun test test/load",
    "seed": "bun run src/infrastructure/database/seeds/seed.ts",
    "migration:create": "bun x mikro-orm migration:create --config ./src/mikro-orm.config.ts",
    "migration:up": "bun run src/infrastructure/database/migrator.ts up",
    "migration:down": "bun run src/infrastructure/database/migrator.ts down"
  },
  "mikro-orm": {
    "useTsNode": false,
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ]
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3"
  }
}